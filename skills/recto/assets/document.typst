$recto-preamble$
$if(title)$
#set document(title: [$title$])
$endif$
#let horizontalrule = line(length: 100%, stroke: 0.5pt)
#set heading(numbering: none)
#set math.equation(numbering: none)
#set figure(gap: 0.65em)
#show figure.where(kind: table): set figure.caption(position: bottom)
#show figure.where(kind: image): set figure.caption(position: bottom)
#set table(inset: (x: 6pt, y: 7pt), stroke: 0.5pt)
$if(highlighting-definitions)$
$highlighting-definitions$
$endif$
$if(recto-course)$
#show: reference-layout
#set table(stroke: (top: none, bottom: 0.35pt, left: none, right: none))
#set footnote.entry(separator: line(length: 22%, stroke: 0.4pt), clearance: 1em)
// Headings in the shared Markdown carry their visible numbers explicitly.
#show heading.where(level: 2): it => block(above: 20pt, below: 10pt, sticky: true)[
  #line(length: 100%, stroke: 0.5pt)
  #v(12pt)
  #text(size: 13.5pt, weight: "bold")[#it.body]
]
$if(title)$
#reference-title([$title$], [$subtitle$])
$endif$
$else$
#show: gbt-layout
#show table: set par(first-line-indent: 0pt, justify: false, leading: 0.55em, spacing: 0pt)
#show table: set text(tracking: 0pt)
#show table.cell.where(y: 0): set text(font: hei-font)
$if(title)$
#document-title[$title$]
$endif$
$endif$
$body$
